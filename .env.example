# ==============================================================================
# JAI BHAGWAN WORKER MANAGEMENT - ENVIRONMENT CONFIGURATION
# ==============================================================================
# 1. Sign up / Log in to Supabase (https://supabase.com)
# 2. Create a new project (e.g. "jai-bhagwan-workers")
# 3. Go to Project Settings -> API
# 4. Copy 'Project URL' into VITE_SUPABASE_URL
# 5. Copy 'anon / public' key into VITE_SUPABASE_ANON_KEY
# ==============================================================================

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Optional: Default Admin Email (for prefill on login screen)
VITE_ADMIN_EMAIL=admin@jaibhagwan.com
